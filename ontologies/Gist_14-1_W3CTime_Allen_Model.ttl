###  https://w3id.org/semanticarts/ns/ontology/gist/Restriction
gist:Restriction rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( gist:Intention
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gist:prevents ;
                                                              owl:someValuesFrom gist:Behavior
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:isDefinedBy <https://w3id.org/semanticarts/ontology/gistCore14.1.0> ;
                 skos:definition "A description of things one is prevented from doing." ;
                 skos:example "In the US, tax laws restrict the amount of money a person can put in retirement accounts over the course of a year." ;
                 skos:prefLabel "Restriction" .


###  https://w3id.org/semanticarts/ns/ontology/gist/ScheduledEvent
gist:ScheduledEvent rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( gist:Event
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty gist:plannedStartDateTime ;
                                                                 owl:someValuesFrom xsd:dateTime
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:isDefinedBy <https://w3id.org/semanticarts/ontology/gistCore14.1.0> ;
                    skos:definition "An event with a planned start datetime." ;
                    skos:prefLabel "Scheduled Event" ;
                    skos:scopeNote "If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event." .


###  https://w3id.org/semanticarts/ns/ontology/gist/ScheduledTask
gist:ScheduledTask rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( gist:ScheduledEvent
                                                              gist:Task
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:isDefinedBy <https://w3id.org/semanticarts/ontology/gistCore14.1.0> ;
                   skos:definition "A task with a planned start datetime." ;
                   skos:prefLabel "Scheduled Task" ;
                   skos:scopeNote "If work on the task has already started, but has not yet ended, it will have an actual start datetime. If the task is completed, it will also have an actual end datetime. The task always retains its planned start time, and thus continues to be a scheduled task." .


###  https://w3id.org/semanticarts/ns/ontology/gist/SchemaMetaData
gist:SchemaMetaData rdf:type owl:Class ;
                    owl:disjointWith gist:UnitOfMeasure ;
