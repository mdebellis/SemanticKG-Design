PREFIX :     <https://michaeldebellis.com/consulting_taxonomy/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX sulo: <https://w3id.org/sulo/>

# Listing 12-1
# Query to see initial SKOS taxonomy
SELECT DISTINCT ?parent ?child
WHERE {VALUES ?scheme { :Consulting_Firm_Taxonomy }
  ?root  skos:topConceptOf ?scheme .
  ?root  (skos:narrower)* ?parent .
  ?parent skos:narrower ?child .}
ORDER BY ?parent ?child

# Listing 12-2
# To begin make the root node of the taxonomy and 
# its children into OWL classes
INSERT {:Consulting_Firm rdf:type owl:Class .
        ?concept rdf:type owl:Class .}
WHERE {:Consulting_Firm skos:narrower ?concept .}

# Listing 12-3. SPARQL to transform the appropriate narrower links to rdf:type	   
# The children (nodes that are skos:narrower) of Client are instances.
INSERT {?client rdf:type :Client.}
WHERE {:Client skos:narrower ?client.}

# Listing 12-3. SPARQL to transform the appropriate narrower links to rdf:type
# The children (skos:narrower) of Industry are instances.
INSERT {?industry rdf:type :Industry.}
WHERE {:Industry skos:narrower ?industry.}

# Listing 12-3. SPARQL to transform the appropriate narrower links to rdf:type
# The children (nodes that are skos:narrower) of Engagement are instances.
INSERT {?engagement rdf:type :Engagement.}
WHERE {:Engagement  skos:narrower ?engagement.}

# Listing 12-4. Transforming appropriate narrower links to subclass relations
# The rest of the children of the second level concepts are subclasses
INSERT {?child rdfs:subClassOf ?parent .}
WHERE {SELECT DISTINCT ?child ?parent 
	WHERE {
		{ :Deliverable skos:narrower ?child . BIND(:Deliverable   AS ?parent) }
		UNION
		{ :Offering skos:narrower ?child . BIND(:Offering AS ?parent) }
		UNION
		{ :Service_Line  skos:narrower ?child . BIND(:Service_Line  AS ?parent) }
		UNION
		{ :Team  skos:narrower ?child . BIND(:Team AS ?parent) }}}

# Listing 12-5. Adding a has part object property to the ontology
# Add object property before using it
INSERT DATA {sulo:hasDirectPart rdf:type owl:ObjectProperty ;
             rdfs:label "has direct part"@en .}

# Listing 12-6. Using hasDirectPart to transform narrower links to sub-part relations
# The children of Engagements are parts of the engagement (safe; no cross product)
INSERT {?engagement sulo:hasDirectPart ?part .}
WHERE {{ :Acme_KYC_Modernization  skos:narrower ?part . BIND(:Acme_KYC_Modernization  AS ?engagement)}
  UNION
  {:Northwind_Claims_RAG    skos:narrower ?part . BIND(:Northwind_Claims_RAG    AS ?engagement)}}
  

# Additional query
# Some narrower links don’t directly transform to a simple OWL relation
# Final graph for Gruff:
# - skos:narrower only from :Consulting_Firm
# - everywhere else show only rdf:type, sulo:hasDirectPart, rdfs:subClassOf
# - suppress non-: nodes (e.g., sulo classes like Collection/OrderedCollection)
PREFIX :     <https://michaeldebellis.com/consulting_taxonomy/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX sulo: <https://w3id.org/sulo/>
SELECT DISTINCT ?subject ?predicate ?object
WHERE {
  {
    # Consulting Firm -> top-level concepts
    {
      BIND(:Consulting_Firm AS ?subject)
      BIND(skos:narrower AS ?predicate)
    }
    UNION
    # Deliverable subclasses -> Deliverable
    {
      BIND(:Deliverable AS ?object)
      BIND(rdfs:subClassOf AS ?predicate)
    }
    UNION
    # Client instances -> Client
    {
      BIND(:Client AS ?object)
      BIND(rdf:type AS ?predicate)
    }
    UNION
    # Engagement instances -> Engagement
    {
      BIND(:Engagement AS ?object)
      BIND(rdf:type AS ?predicate)
    }
    UNION
    # Offering subclasses -> Offering
    {
      BIND(:Offering AS ?object)
      BIND(rdfs:subClassOf AS ?predicate)
    }
    UNION
    # Industry instances -> Industry
    {
      BIND(:Industry AS ?object)
      BIND(rdf:type AS ?predicate)
    }
    UNION
    # Service Line subclasses -> Service Line
    {
      BIND(:Service_Line AS ?object)
      BIND(rdfs:subClassOf AS ?predicate)
    }
    UNION
    # Team subclasses -> Team
    {
      BIND(:Team AS ?object)
      BIND(rdfs:subClassOf AS ?predicate)
    }
    UNION
    # Individual engagements -> their direct parts
    {
      ?subject rdf:type :Engagement .
      BIND(sulo:hasDirectPart AS ?predicate)
    }
  }

  # Retrieve the triples selected by the bindings above
  ?subject ?predicate ?object .

  # Exclude owl:Nothing
  FILTER(?subject != owl:Nothing && ?object != owl:Nothing)

  # Keep both endpoints in the consulting taxonomy namespace
  FILTER(
    STRSTARTS(STR(?subject), STR(:)) &&
    STRSTARTS(STR(?object), STR(:))
  )
}
ORDER BY ?predicate ?subject ?object

# Additional queries, not in book for the book glossary knowledge graph
PREFIX :     <https://www.michaeldebellis.com/glossary/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT *
WHERE {?s skos:narrower ?o}

SELECT DISTINCT *
WHERE {?s skos:broader ?o}
	   
	   
