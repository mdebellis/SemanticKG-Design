###  https://w3id.org/semanticarts/ns/ontology/gist/RenderedContent
gist:RenderedContent rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( gist:FormattedContent
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty gist:isRenderedOn ;
