###  https://w3id.org/semanticarts/ns/ontology/gist/Project
gist:Project rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( gist:Task
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty [ owl:inverseOf gist:isPartOf
                                                                         ] ;
                                                          owl:someValuesFrom gist:Task
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:isDefinedBy <https://w3id.org/semanticarts/ontology/gistCore14.1.0> ;
             skos:definition "A task, usually of longer duration, made up of other tasks." ;
             skos:example "Designing an insurance product; adding a new feature to a software application; assessing the level of risk for a mortgage application." ;
             skos:prefLabel "Project" .


###  https://w3id.org/semanticarts/ns/ontology/gist/ReferenceValue
gist:ReferenceValue rdf:type owl:Class ;
                    rdfs:subClassOf gist:Magnitude ;
                    rdfs:isDefinedBy <https://w3id.org/semanticarts/ontology/gistCore14.1.0> ;
                    skos:definition "A magnitude that was neither measured nor estimated but set by fiat." ;
                    skos:example "The sales goal for a company." ;
